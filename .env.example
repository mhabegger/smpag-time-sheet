# ZEP Time Tracking API
ZEP_INSTANCE=zepsmpag
ZEP_TOKEN=your-bearer-token
ZEP_EMPLOYEE_ID=mhabegger

# ManicTime (optional overrides)
# MANICTIME_SCREENSHOTS_PATH=D:\ManicTime\Screenshots
# MANICTIME_MCP_PATH=C:\Program Files\ManicTime\ManicTimeMcp.exe

# Web app analyzer (optional)
# ANTHROPIC_API_KEY=sk-ant-...        # use the Anthropic API directly
# TIMESHEET_LLM=cli                   # force backend: api | cli (claude -p)
# TIMESHEET_MODEL=claude-opus-4-8     # model for analysis
# TIMESHEET_RANGE_START=2026-04-01    # dashboard range start (default: 3 months back)
# CLAUDE_CLI_PATH=claude              # path to the Claude Code CLI
